# ==============================================================================
# YTMusic Backend — Environment Template
#   Для локальной разработки:  cp .env.example .env
# ==============================================================================

# --- Application ---
DEBUG=True
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace_with_a_secure_random_secret_key
ALLOWED_HOSTS=["localhost", "127.0.0.1", "0.0.0.0"]
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# --- PostgreSQL Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ytmusic

# --- S3-Compatible Storage (MinIO локально / Cloudflare R2 в проде) ---
R2_ACCOUNT_ID=replace_with_account_id
R2_ACCESS_KEY_ID=replace_with_access_key_id
R2_SECRET_ACCESS_KEY=replace_with_r2_secret_key
R2_BUCKET=yt-music

# Для MinIO локально: http://localhost:9000 (или http://minio:9000 в docker-compose)
# Для Cloudflare R2:   закомментируй R2_ENDPOINT_URL (соберётся автоматически из ACCOUNT_ID)
R2_ENDPOINT_URL=http://localhost:9000
# Публичный домен R2 (если настроен Custom Domain в Cloudflare):
R2_PUBLIC_ENDPOINT_URL=
# Срок жизни ссылки на стрим/обложку (в секундах: 3600 = 1 час)
R2_PRESIGNED_URL_EXPIRE_SECONDS=3600

# --- JWT & Authentication ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=900 
REFRESH_TOKEN_EXPIRE_SECONDS=604800   

# --- Redis (Кэширование поиска и Rate Limiting) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Локально redis в docker-compose поднимается без авторизации — оставь пустым.
# В проде укажи пароль и добавь --requirepass в команду сервиса.
REDIS_PASSWORD=

# --- SMTP (Отправка писем: подтверждение почты, сброс пароля) ---
# Локально удобно поднять заглушку без авторизации:
#   docker run -p 1025:1025 -p 8025:8025 axllent/mailpit
#   тогда SMTP_HOST=localhost, SMTP_PORT=1025, USERNAME/PASSWORD оставить пустыми
SMTP_HOST=localhost
SMTP_PORT=1025
# Для Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_PASSWORD — пароль приложения, не пароль от аккаунта
SMTP_USERNAME=
SMTP_PASSWORD=
# Адрес в поле From
SMTP_SENDER=noreply@ytmusic.local
