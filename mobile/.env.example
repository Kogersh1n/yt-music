# Адрес бэкенда, который увидит приложение.
#
# Телефон не видит localhost машины — нужен адрес в локальной сети.
# Свой можно узнать так: ip -4 addr show scope global | grep -oP 'inet \K[\d.]+'
# Прод (Oracle ARM, TLS через nginx + Let's Encrypt):
#   EXPO_PUBLIC_API_URL=https://ytmusic.82-70-63-136.nip.io
# Локальный стек по LAN-адресу машины:
EXPO_PUBLIC_API_URL=http://192.168.8.12:8000
